-- 1. Подключение библиотеки
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/Maks14a/GUIs/refs/heads/main/Library/Emeraldy.lua"))()

-- 2. Создание главного окна (Поддерживает RichText для авто-цвета версии)
local Window = Library:CreateWindow("OWNER HUB")

-- 3. Создание вкладки (Tab)
local Tab = Window:CreateTab("Название Вкладки")

-- 4. Добавление Секции / Заголовка
Tab:AddSection("Заголовок группы")

-- 5. Добавление Текстовой Метки (Label)
Tab:AddLabel("Простой текст", Color3.fromRGB(255, 255, 255)) -- Внутренний цвет опционален

-- 6. Добавление Кнопки (Button)
Tab:AddButton("Кнопка", function()
    print("Кнопка нажата!")
end)

-- 7. Добавление Переключателя (Toggle)
local myToggle = Tab:AddToggle("Авто-Фарм", false, function(state)
    print("Состояние переключателя:", state)
end)
-- Управление из кода: myToggle:Set(true)

-- 8. Добавление Поля Ввода (Input)
Tab:AddInput("Скорость", "50", function(text)
    print("Введено значение:", text)
end)

-- 9. Добавление Выпадающего Списка (Single Dropdown)
local myDrop = Tab:AddDropdown("Выбор Режима", {"Режим 1", "Режим 2"}, "Режим 1", function(selected)
    print("Выбрано:", selected)
end)
-- Обновление списка из кода: myDrop:Refresh({"Новый 1", "Новый 2"}, "Новый 1")

-- 10. Добавление Множественного Выбора (Multi Dropdown)
Tab:AddMultiDropdown("Цели", {"Цель A", "Цель B", "Цель C"}, function(selectedTable)
    -- selectedTable = { ["Цель A"] = true, ["Цель B"] = nil }
    for item, isSelected in pairs(selectedTable) do
        print(item, isSelected)
    end
end)

-- 11. Добавление Слайдера (Slider)
Tab:AddSlider("Скорость бега", 16, 200, 16, 1, function(value)
    game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = value
end)

-- 12. Добавление Выбора Клавиши (Keybind)
Tab:AddKeybind("Горячая клавиша", Enum.KeyCode.E, function(key)
    print("Нажата назначена клавиша:", key.Name)
end)

-- 13. Отправка Уведомления (Notification)
Library:Notify("Уведомление", "Текст сообщения", 3.5)

-- 14. Смена Темы из Кода (Мгновенно с анимацией)
Window:SetTheme("Ruby") -- Доступны: Emerald, Ruby, Sapphire, Amethyst, Amber
