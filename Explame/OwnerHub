--- [ Всплывающее Уведомление (Notification) ]
-- Аргументы: (Заголовок, Сообщение, ДлительностьСекунд)
Library:Notify("УСПЕХ", "Скрипт успешно подключен!", 3)

--- 🆕 [ Всплывающая Подсказка при Наведении (Tooltip) ]
-- Привязывается к абсолютно любому элементу UI и плавно следит за мышкой
local FastBtn = MainTab:AddButton("Удалить всё", function() end)
Library:AddTooltip(FastBtn, "Осторожно! Действие нельзя будет отменить.")

--- 🆕 [ Модальное Диалоговое Окно (ShowPrompt) ]
-- Затеняет экран и выводит модальное окно с выбором действий
Library:ShowPrompt("Внимание!", "Вы действительно хотите сбросить настройки?", {
    { Text = "Отмена", Primary = false, Callback = function() print("Отменено") end },
    { Text = "Сбросить", Primary = true, Callback = function() print("Сброшено!") end }
})

--- [ Программная смена темы ]
-- Доступные темы: "Emerald", "Ruby", "Sapphire", "Amethyst", "Amber"
Window:SetTheme("Sapphire")
